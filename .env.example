# ==============================================================================
# ChessTogether — Environment Variables Configuration
# Copy this file to .env.local for local frontend dev,
# or set these environment variables in Railway / Vercel / VPS production.
# ==============================================================================

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# In local dev: leave NEXT_PUBLIC_SOCKET_URL blank to auto-connect to localhost:9092.
# In unified container production (Railway/VPS): leave blank to auto-connect via same-origin WSS.
# In split deployment (Vercel): set to your backend domain, e.g. wss://api.chesstogether.com
NEXT_PUBLIC_SOCKET_URL=


# Spring Boot HTTP port (default: 8080)
SERVER_PORT=8080

# Netty Socket.IO WebSocket port (default: 9092)
SOCKETIO_PORT=9092
SOCKETIO_HOST=0.0.0.0

# ── Deployment / Unified Container (Railway / Docker) ─────────────────────────
# Container public ingress port (passed automatically by Railway, default: 8080)
PORT=8080
NODE_ENV=production
